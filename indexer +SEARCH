def search(query, lang="fr", limit=40):
if not query or not query.strip():
return {"query": query, "results": [], "count": 0, "sources": []}

ck = (query.lower(), lang, limit)
cached = cache_get(ck)
if cached:
return cached

t0 = time.time()
log("SEARCH : " + query)

# 1) Interne d'abord (rapide)
internal = IDX.search_local(query, limit=limit)

# 2) Sources externes en parallèle
external = []
with ThreadPoolExecutor(max_workers=len(SOURCES) + 2) as ex:
futures = {}
for fn in SOURCES:
if "lang" in fn.__code__.co_varnames:
fut = ex.submit(fn, query, lang)
else:
fut = ex.submit(fn, query)
futures[fut] = fn.__name__
for fut in as_completed(futures, timeout=15):
try:
res = fut.result(timeout=10)
if res:
external.extend(res)
except Exception:
pass

# 3) Fusion + ranking
all_res = internal + external
ranked = rank(all_res, query)

# 4) Indexer les résultats externes localement pour la prochaine fois
def _index_async(results):
for r in results[:20]:
pid = IDX.add_page(r.get("url"), r.get("title"), r.get("snippet"),
r.get("source"), r.get("score", 50))
if pid:
IDX.index_page_terms(pid, (r.get("title") or "") + " " + (r.get("snippet") or ""))
threading.Thread(target=_index_async, args=(external,), daemon=True).start()

duration_ms = round((time.time() - t0) * 1000, 2)
result = {
"query": query,
"lang": lang,
"timestamp": datetime.datetime.now().isoformat(),
"count": len(ranked),
"sources": sorted(set(r.get("source", "") for r in ranked if r.get("source"))),
"duration_ms": duration_ms,
"internal_matches": len(internal),
"external_matches": len(external),
"results": ranked[:limit],
}
cache_set(ck, result)

log("DONE {} results in {}ms (internal={} external={})".format(
len(ranked), duration_ms, len(internal), len(external)))
return result


