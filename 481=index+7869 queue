def search(query, lang="fr", limit=40):
if not query or not query.strip():
return {"query": query, "results": [], "count": 0, "sources": []}

ck = (query.lower(), lang, limit)
cached = cache_get(ck)
if cached:
cached["cached"] = True
return cached

t0 = time.time()
log("SEARCH : " + query)

internal = IDX.search_local(query, limit=limit)

external = []
with ThreadPoolExecutor(max_workers=min(len(SOURCES), 12)) as ex:
futures = [ex.submit(fn, query) for fn in SOURCES]
for fut in as_completed(futures, timeout=20):
try:
res = fut.result(timeout=12)
if res:
external.extend(res)
except Exception:
pass

ranked = rank(internal + external, query)

def _idx(results):
for r in results[:20]:
pid = IDX.add_page(
r.get("url"),
r.get("title"),
r.get("snippet"),
r.get("source"),
r.get("score", 50)
)
if pid:
IDX.index_page_terms(
pid,
(r.get("title") or "") + " " + (r.get("snippet") or "")
)

threading.Thread(target=_idx, args=(external,), daemon=True).start()

duration_ms = round((time.time() - t0) * 1000, 2)
result = {
"query": query,
"lang": lang,
"timestamp": datetime.datetime.now().isoformat(),
"count": len(ranked),
"sources": sorted(set(r.get("source", "") for r in ranked if r.get("source"))),
"duration_ms": duration_ms,
"internal_matches": len(internal),
"external_matches": len(external),
"cached": False,
"results": ranked[:limit],
}
cache_set(ck, result)
log("DONE {} results in {}ms (int={} ext={})".format(
len(ranked), duration_ms, len(internal), len(external)))
return result


