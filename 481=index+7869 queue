def cache_get(key):
with CACHE_LOCK:
if key in CACHE:
ts, data = CACHE[key]
if time.time() - ts < CACHE_TTL:
CACHE.move_to_end(key)
return data
del CACHE[key]
return None


def cache_set(key, data):
with CACHE_LOCK:
CACHE[key] = (time.time(), data)
while len(CACHE) > CACHE_MAX:
CACHE.popitem(last=False)


def cache_stats():
with CACHE_LOCK:
return {"size": len(CACHE), "max": CACHE_MAX, "ttl": CACHE_TTL}


