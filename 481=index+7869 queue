class HTMLExtractor(HTMLParser):
def __init__(self, base_url=""):
super().__init__()
self.base_url = base_url
self.title = ""
self.description = ""
self.text_parts = []
self.links = []
self._in_title = False
self._in_script = False
self._in_style = False
self._in_head = False

def handle_starttag(self, tag, attrs):
a = dict(attrs)
tag = tag.lower()
if tag == "title":
self._in_title = True
elif tag == "script":
self._in_script = True
elif tag == "style":
self._in_style = True
elif tag == "head":
self._in_head = True
elif tag == "meta":
n = (a.get("name") or "").lower()
p = (a.get("property") or "").lower()
c = a.get("content", "")
if n == "description" or p == "og:description":
self.description = c[:500]
elif p == "og:title" and not self.title:
self.title = c[:200]
elif tag == "a":
href = a.get("href", "")
if href and not href.startswith(("javascript:", "mailto:", "#")):
self.links.append(urllib.parse.urljoin(self.base_url, href))

def handle_endtag(self, tag):
t = tag.lower()
if t == "title":
self._in_title = False
elif t == "script":
self._in_script = False
elif t == "style":
self._in_style = False
elif t == "head":
self._in_head = False

def handle_data(self, data):
if self._in_script or self._in_style:
return
if self._in_title:
self.title += data
elif not self._in_head:
s = data.strip()
if s:
self.text_parts.append(s)

def result(self):
return {
"title": self.title.strip()[:300],
"description": self.description.strip(),
"text": " ".join(self.text_parts)[:300000],
"links": self.links[:300],
}


