class Indexer:
def __init__(self):
self.lock = threading.RLock()
self.running = False
self.workers = []
self.num_workers = DEFAULT_WORKERS
self.stats = {
"pages_fetched": 0,
"pages_indexed": 0,
"pages_failed": 0,
"pages_duplicate": 0,
"links_found": 0,
"started_at": None,
"rate_per_min": 0,
"last_page": "",
}
self.robots = {}
self.robots_lock = threading.RLock()
self.queue = []
self.queue_lock = threading.RLock()
self.seen_urls = set()
self.seen_lock = threading.RLock()
self.simhashes = {}
self.simhash_lock = threading.RLock()

def add_url(self, url, priority=5):
if not url:
return False
if not url.startswith(("http://", "https://")):
url = "https://" + url
with self.seen_lock:
if url in self.seen_urls:
return False
self.seen_urls.add(url)
with self.queue_lock:
self.queue.append((priority, url))
self.queue.sort(key=lambda x: x[0])
return True

def queue_size(self):
with self.queue_lock:
return len(self.queue)

def can_fetch(self, url):
try:
p = urllib.parse.urlparse(url)
dom = p.netloc
with self.robots_lock:
if dom in self.robots:
rp = self.robots[dom]
else:
rp = urllib.robotparser.RobotFileParser()
rp.set_url(p.scheme + "://" + dom + "/robots.txt")
try:
rp.read()
except Exception:
rp = None
self.robots[dom] = rp
if rp is None:
return True
return rp.can_fetch(UA, url)
except Exception:
return True

def is_dup(self, sh):
with self.simhash_lock:
for known in self.simhashes:
if hamming(sh, known) <= SIMHASH_THRESHOLD:
return True
self.simhashes[sh] = time.time()
return False

def fetch(self, url, timeout=DEFAULT_TIMEOUT):
try:
req = urllib.request.Request(url, headers={
"User-Agent": UA,
"Accept": "text/html,application/xhtml+xml",
"Accept-Language": "fr-FR,fr;q=0.9,en;q=0.8",
"Accept-Encoding": "gzip",
})
with urllib.request.urlopen(req, timeout=timeout, context=SSL_CTX) as r:
ct = r.headers.get("Content-Type", "").lower()
if "text/html" not in ct and "application/xhtml" not in ct:
return None
raw = r.read(MAX_PAGE_SIZE + 1)
if len(raw) > MAX_PAGE_SIZE:
raw = raw[:MAX_PAGE_SIZE]
if r.headers.get("Content-Encoding", "").lower() == "gzip":
try:
raw = gzip.decompress(raw)
except Exception:
pass
enc = "utf-8"
m = re.search(r"charset=([\w\-]+)", ct)
if m:
enc = m.group(1)
return raw.decode(enc, errors="ignore")
except Exception:
return None

def index_url(self, url):
if not self.can_fetch(url):
return None
html_txt = self.fetch(url)
if not html_txt:
with self.lock:
self.stats["pages_failed"] += 1
return None
try:
parser = HTMLExtractor(base_url=url)
parser.feed(html_txt)
data = parser.result()
except Exception:
with self.lock:
self.stats["pages_failed"] += 1
return None

title = data["title"] or url
description = data["description"]
content = data["text"]
if len(content) < 100:
with self.lock:
self.stats["pages_failed"] += 1
return None

sh = simhash(title + " " + content[:5000])
if self.is_dup(sh):
with self.lock:
self.stats["pages_duplicate"] += 1
return None

domain = urllib.parse.urlparse(url).netloc
pid = IDX.add_page(url, title, description or content[:500], "CRAWL", 60)
if pid:
IDX.index_page_terms(pid, title + " " + content[:50000])

with self.lock:
self.stats["pages_fetched"] += 1
self.stats["pages_indexed"] += 1
self.stats["links_found"] += len(data["links"])
self.stats["last_page"] = url

for link in data["links"]:
link_dom = urllib.parse.urlparse(link).netloc
prio = 3 if link_dom == domain else 7
self.add_url(link, priority=prio)

return {"url": url, "title": title[:80]}

def worker_loop(self, wid):
while self.running:
batch = []
with self.queue_lock:
batch = self.queue[:8]
self.queue = self.queue[8:]
if not batch:
time.sleep(0.3)
continue
for prio, url in batch:
if not self.running:
return
try:
r = self.index_url(url)
if r:
ilog("[W{}] {}".format(wid, r["url"][:90]))
except Exception as e:
ilog("[W{}] err {}".format(wid, str(e)[:100]))

def start(self, num_workers=None):
if self.running:
return False
self.num_workers = num_workers or DEFAULT_WORKERS
self.num_workers = max(2, min(MAX_WORKERS, self.num_workers))
self.running = True
self.stats["started_at"] = time.time()
for i in range(self.num_workers):
t = threading.Thread(target=self.worker_loop, args=(i,), daemon=True)
t.start()
self.workers.append(t)
ilog("Indexer demarre : {} workers".format(self.num_workers))
return True

def stop(self):
self.running = False
ilog("Indexer arrete")

def status(self):
with self.lock:
s = dict(self.stats)
elapsed = time.time() - s["started_at"] if s["started_at"] else 0
if elapsed > 0:
s["rate_per_min"] = round(s["pages_indexed"] / elapsed * 60, 1)
s["elapsed_s"] = round(elapsed, 1)
s["running"] = self.running
s["workers"] = self.num_workers
s["queue"] = self.queue_size()
return s


INDEXER = Indexer()


