class LocalIndex:
def __init__(self, path=DB_FILE):
self.path = str(path)
self.local = threading.local()
self.lock = threading.RLock()
self._init()

def _conn(self):
if not hasattr(self.local, "conn"):
conn = sqlite3.connect(self.path, timeout=30,
check_same_thread=False, isolation_level=None)
conn.execute("PRAGMA journal_mode=WAL")
conn.execute("PRAGMA synchronous=NORMAL")
conn.execute("PRAGMA cache_size=-64000")
conn.execute("PRAGMA temp_store=MEMORY")
self.local.conn = conn
return self.local.conn

def _init(self):
with self.lock:
conn = self._conn()
cur = conn.cursor()
cur.execute(
"CREATE TABLE IF NOT EXISTS pages ("
"id INTEGER PRIMARY KEY AUTOINCREMENT,"
"url TEXT UNIQUE,"
"title TEXT,"
"snippet TEXT,"
"source TEXT,"
"score INTEGER,"
"added_at REAL)"
)
cur.execute("CREATE INDEX IF NOT EXISTS idx_url ON pages(url)")
cur.execute("CREATE INDEX IF NOT EXISTS idx_source ON pages(source)")
cur.execute(
"CREATE TABLE IF NOT EXISTS terms ("
"term TEXT,"
"page_id INTEGER,"
"freq INTEGER,"
"PRIMARY KEY (term, page_id))"
)
cur.execute("CREATE INDEX IF NOT EXISTS idx_term ON terms(term)")
cur.execute("CREATE INDEX IF NOT EXISTS idx_page ON terms(page_id)")
conn.commit()

def add_page(self, url, title, snippet, source, score):
if not url:
return None
with self.lock:
conn = self._conn()
cur = conn.cursor()
try:
cur.execute(
"INSERT OR IGNORE INTO pages "
"(url,title,snippet,source,score,added_at) VALUES (?,?,?,?,?,?)",
(url, (title or "")[:500], (snippet or "")[:1000],
source, score, time.time())
)
if cur.rowcount == 0:
cur.execute("SELECT id FROM pages WHERE url = ?", (url,))
r = cur.fetchone()
return r[0] if r else None
return cur.lastrowid
except Exception as e:
log("add_page err " + str(e)[:80])
return None

def index_page_terms(self, page_id, text):
if not page_id or not text:
return 0
words = tokenize(text)
if not words:
return 0
freq = Counter(words)
with self.lock:
conn = self._conn()
cur = conn.cursor()
try:
cur.executemany(
"INSERT OR REPLACE INTO terms (term,page_id,freq) VALUES (?,?,?)",
[(w, page_id, n) for w, n in freq.items()]
)
return len(freq)
except Exception:
return 0

def search_local(self, query, limit=20):
words = tokenize(query)
if not words:
return []
ph = ",".join("?" * len(words))
with self.lock:
conn = self._conn()
cur = conn.cursor()
cur.execute(
"SELECT page_id, SUM(freq) AS s FROM terms WHERE term IN (" +
ph + ") GROUP BY page_id ORDER BY s DESC LIMIT ?",
words + [limit]
)
ids = [r[0] for r in cur.fetchall()]
if not ids:
return []
ph2 = ",".join("?" * len(ids))
cur.execute(
"SELECT id,url,title,snippet,source,score FROM pages WHERE id IN (" + ph2 + ")",
ids
)
out = []
for r in cur.fetchall():
out.append({
"id": r[0],
"url": r[1],
"title": r[2],
"snippet": r[3],
"source": "INDEX:" + (r[4] or ""),
"score": (r[5] or 50) + 20,
"score_final": (r[5] or 50) + 20,
})
return out

def stats(self):
with self.lock:
conn = self._conn()
cur = conn.cursor()
cur.execute("SELECT COUNT(*) FROM pages")
p = cur.fetchone()[0] or 0
cur.execute("SELECT COUNT(*) FROM terms")
t = cur.fetchone()[0] or 0
return {"pages": p, "terms": t}

def top_terms(self, limit=20):
with self.lock:
conn = self._conn()
cur = conn.cursor()
cur.execute(
"SELECT term, COUNT(DISTINCT page_id) AS df FROM terms "
"GROUP BY term ORDER BY df DESC LIMIT ?", (limit,)
)
return [{"term": r[0], "df": r[1]} for r in cur.fetchall()]

def recent(self, limit=10):
with self.lock:
conn = self._conn()
cur = conn.cursor()
cur.execute(
"SELECT url,title,source,added_at FROM pages ORDER BY id DESC LIMIT ?",
(limit,)
)
return [{"url": r[0], "title": r[1], "source": r[2], "ts": r[3]}
for r in cur.fetchall()]


