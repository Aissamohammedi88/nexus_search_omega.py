class Handler(BaseHTTPRequestHandler):
def log_message(self, *a):
pass

def _json(self, data, code=200):
try:
body = json.dumps(data, ensure_ascii=False, default=str).encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", "application/json; charset=utf-8")
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("X-Powered-By", "NexusSearch/" + VERSION)
self.end_headers()
self.wfile.write(body)
except Exception:
pass

def _html(self, content, code=200):
try:
body = content.encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", "text/html; charset=utf-8")
self.send_header("Content-Length", str(len(body)))
self.send_header("Cache-Control", "no-cache")
self.end_headers()
self.wfile.write(body)
except Exception:
pass

def _read_json(self):
try:
n = int(self.headers.get("Content-Length", 0))
if n == 0:
return {}
return json.loads(self.rfile.read(n).decode("utf-8"))
except Exception:
return {}

def do_GET(self):
p = urllib.parse.urlparse(self.path)
path = p.path

if path in ("/", "/index.html"):
self._html(HTML_PAGE)
return

if path == "/api/search":
qs = urllib.parse.parse_qs(p.query)
q = (qs.get("q", [""])[0] or "").strip()
limit = int(qs.get("limit", ["40"])[0])
lang = qs.get("lang", ["fr"])[0]
if not q:
self._json({"error": "q required"}, 400)
return
result = search(q, lang=lang, limit=limit)
self._json(result)
return

if path == "/api/stats":
stats = IDX.stats()
stats["crawler"] = INDEXER.status()
stats["cache"] = cache_stats()
stats["version"] = VERSION
stats["sources"] = len(SOURCES)
self._json(stats)
return

if path == "/api/top-terms":
qs = urllib.parse.parse_qs(p.query)
limit = int(qs.get("limit", ["20"])[0])
self._json({"terms": IDX.top_terms(limit)})
return

if path == "/api/queue":
self._json({"pending": INDEXER.queue_size()})
return

if path == "/api/indexer":
self._json(INDEXER.status())
return

if path == "/health":
self._json({"status": "ok", "version": VERSION, "auteur": AUTEUR})
return

self._json({"error": "not found"}, 404)

def do_POST(self):
path = urllib.parse.urlparse(self.path).path
payload = self._read_json()

if path == "/api/indexer/start":
workers = int(payload.get("workers", DEFAULT_WORKERS))
ok = INDEXER.start(num_workers=workers)
self._json({"started": ok, "workers": INDEXER.num_workers})
return

if path == "/api/indexer/stop":
INDEXER.stop()
self._json({"stopped": True})
return

if path == "/api/seed":
n = seed_indexer()
self._json({"added": n})
return

if path == "/api/seed-wikipedia":
count = int(payload.get("count", 50))
