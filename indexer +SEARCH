# HTTP HANDLER
# ═══════════════════════════════════════════════════════════════════════════

class Handler(BaseHTTPRequestHandler):
def log_message(self, *a):
pass

def _send(self, code, body, ctype="text/html; charset=utf-8"):
try:
if isinstance(body, str):
body = body.encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Server", "NexusSearch/" + VERSION)
self.end_headers()
self.wfile.write(body)
except (BrokenPipeError, ConnectionResetError):
pass

def _json(self, code, obj):
self._send(code, json.dumps(obj, ensure_ascii=False, default=str),
"application/json; charset=utf-8")

def do_GET(self):
parsed = urllib.parse.urlparse(self.path)
path = parsed.path
qs = urllib.parse.parse_qs(parsed.query)

if path in ("/", "/index.html"):
return self._send(200, HTML.replace("__V__", VERSION))

if path == "/api/search":
q = (qs.get("q", [""])[0] or "").strip()
lang = (qs.get("lang", ["fr"])[0] or "fr")
limit = int(qs.get("limit", ["40"])[0])
if not q:
return self._json(400, {"error": "missing q"})
try:
data = search(q, lang, limit)
return self._json(200, data)
except Exception as e:
return self._json(500, {"error": str(e)[:200]})

if path == "/api/health":
return self._json(200, {
"engine": "NEXUS SEARCH OMEGA",
"version": VERSION,
"auteur": AUTEUR,
"licence": LICENCE,
"sources_count": len(SOURCES),
"sources": [f.__name__ for f in SOURCES],
"cache_size": len(CACHE),
"index": IDX.stats(),
})

if path == "/api/stats":
return self._json(200, {
"cache": len(CACHE),
"cache_max": CACHE_MAX,
"index": IDX.stats(),
"version": VERSION,
})

if path == "/api/sources":
return self._json(200, {
"count": len(SOURCES),
"sources": [f.__name__.replace("src_", "") for f in SOURCES],
})

return self._json(404, {"error": "not found"})


class Server(ThreadingHTTPServer):
daemon_threads = True
allow_reuse_address = True


