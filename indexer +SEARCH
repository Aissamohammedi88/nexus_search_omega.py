# RANKING — score + dédup + bonus
# ═══════════════════════════════════════════════════════════════════════════

def rank(results, query):
words = set(re.findall(r"\w+", query.lower()))
seen = set()
out = []
for r in results:
url = (r.get("url") or "").strip()
if not url:
continue
key = url.split("#")[0].split("?")[0].lower()
if key in seen:
continue
seen.add(key)

score = r.get("score", 50)
title_low = (r.get("title") or "").lower()
snippet_low = (r.get("snippet") or "").lower()

for w in words:
if w in title_low:
score += 8
if w in snippet_low:
score += 3

if url.startswith("https://"):
score += 3

if r.get("source") in ("Wikipedia", "DuckDuckGo"):
score += 10

r["score_final"] = score
out.append(r)

out.sort(key=lambda x: -x["score_final"])
return out


