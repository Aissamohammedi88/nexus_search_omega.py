}

function render() {
if (!allData) return;
let list = allData.results;
if (currentFilter !== 'all') list = list.filter(r => r.source === currentFilter);
if (list.length === 0) {
document.getElementById('results').innerHTML = '<div class="empty"><h2>Aucun resultat</h2><p>Essaie un autre filtre</p></div>';
return;
}
document.getElementById('results').innerHTML = list.map(r => `
<a class="result" href="${escapeAttr(r.url)}" target="_blank" rel="noopener">
<div class="score">${r.score_final}</div>
<span class="src">${escapeHtml(r.source)}</span>
<h3>${escapeHtml(r.title)}</h3>
<p>${escapeHtml(r.snippet)}</p>
<div class="url">${escapeHtml(r.url)}</div>
</a>
`).join('');
}

function escapeHtml(t) {
const d = document.createElement('div');
d.textContent = t == null ? '' : String(t);
return d.innerHTML;
}
function escapeAttr(t) { return escapeHtml(t).replace(/"/g, '&quot;'); }

setTimeout(() => document.getElementById('q').focus(), 100);
</script>
</body>
</html>
"""


