def sha256_bytes(data):
return hashlib.sha256(data).hexdigest()


def simhash(text, bits=64):
if not text:
return 0
tokens = tokenize(text)
if not tokens:
return 0
v = [0] * bits
for tok in tokens:
h = int(hashlib.md5(tok.encode("utf-8", "ignore")).hexdigest()[:16], 16)
for i in range(bits):
v[i] += 1 if (h & (1 << i)) else -1
out = 0
for i in range(bits):
if v[i] > 0:
out |= (1 << i)
return out


def hamming(a, b):
return bin(a ^ b).count("1")


_word_rx = re.compile(
r"[a-zA-ZàâäéèêëïîôöùûüçÀÂÄÉÈÊËÏÎÔÖÙÛÜÇ]"
r"[a-zA-ZàâäéèêëïîôöùûüçÀÂÄÉÈÊËÏÎÔÖÙÛÜÇ0-9'\-]*", re.UNICODE)


def tokenize(text):
if not text:
return []
words = _word_rx.findall(text.lower())
return [w.strip("'-") for w in words
if 3 <= len(w) <= 30 and w not in STOPWORDS]


def detect_lang(text):
if not text:
return "fr"
s = text[:3000].lower()
fr = sum(1 for w in ["le", "la", "les", "un", "une", "des", "et", "est"] if w in s)
en = sum(1 for w in ["the", "a", "an", "and", "is", "are", "in", "of"] if w in s)
return "fr" if fr >= en else "en"


def strip_html(s):
if not s:
return ""
s = re.sub(r"<[^>]+>", " ", s)
s = html.unescape(s)
s = re.sub(r"\s+", " ", s)
return s.strip()


